---
import Arrow from "./Arrow.astro";
import CfsLogo from "./CfsLogo.astro";
import LogoMark from "./LogoMark.astro";
import Swap from "./Swap.astro";
import { navLinks } from "../data/site";
import { withBase } from "../lib/url";
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-news">
        <h2 class="statement-heading" data-animate="rise">Big Ideas, Real Impact.</h2>
        <p data-animate="rise">
          I’m currently preparing a step-by-step e-book for premium furniture brands on how to prepare for
          stronger positioning, clearer value and future-ready growth.
        </p>
        <form class="subscribe" data-form data-animate="rise">
          <div class="subscribe-row">
            <input type="email" name="email" required placeholder="Email address" aria-label="Email address" />
            <button class="btn btn--line" type="submit">
              <span class="swap">
                <span>Sign up</span>
                <span aria-hidden="true">Sign up</span>
              </span>
              <Arrow variant="cta" />
            </button>
          </div>
          <label class="subscribe-consent">
            <input type="checkbox" name="marketing_consent" value="1" required />
            <span class="subscribe-consent__text">
              I consent to receiving newsletters from ANNA JULIA SKAGGS Creative Future Studio at the email address
              provided, containing information about products, new releases, promotions, events, and offers related to 3D
              printing technology. I understand that I can withdraw my consent at any time.
              <a href={withBase("/privacy")}>Privacy Policy</a>.
            </span>
          </label>
          <p class="form-note" hidden>Thank you. The list is not connected yet.</p>
        </form>
      </div>
      <div class="footer-links" data-animate="rise">
        <nav class="footer-nav" aria-label="Footer">
          {navLinks.map((link) => <Swap href={link.href} label={link.label} pl={link.pl} />)}
          <Swap href={withBase("/contact")} label="Book a Strategy Call" pl="Umów rozmowę strategiczną" />
        </nav>
        <Swap
          href="https://www.linkedin.com/in/anna-julia-skaggs"
          class="footer-social"
          label="LinkedIn"
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>
    </div>
    <div class="footer-meta">
      <p class="footer-meta__brand">
        <LogoMark inline />
        <span class="footer-meta__sep">–</span>
        <span class="footer-meta__tagline">Design direction, clarity and future insight ©2026</span>
      </p>
      <p>Created with love by Spacers</p>
    </div>
    <p class="footer-logo" aria-hidden="true">
      <CfsLogo />
    </p>
  </div>
</footer>
