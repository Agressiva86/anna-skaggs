---
import Arrow from "./Arrow.astro";
import Swap from "./Swap.astro";
import { navLinks } from "../data/site";
import { withBase } from "../lib/url";
---

<div class="menu">
  <div class="menu__shell">
    <nav class="menu__nav" aria-label="Primary">
      {
        navLinks.map((link) =>
          link.children ? (
            <div class="menu__group">
              <Swap href={link.href} class="menu__link" label={link.label} pl={link.pl}>
                <Arrow slot="after" />
              </Swap>
              {link.children.map((child) => (
                <a class="menu__sub" href={child.href} data-en={child.label} data-pl={child.pl}>
                  {child.label}
                </a>
              ))}
            </div>
          ) : (
            <Swap href={link.href} class="menu__link" label={link.label} pl={link.pl}>
              <Arrow slot="after" />
            </Swap>
          )
        )
      }
    </nav>
  </div>
  <div class="menu__foot">
    <Swap
      href={withBase("/contact")}
      class="btn btn--accent menu__cta"
      label="Get In Touch"
      pl="Napisz do nas"
    >
      <Arrow slot="after" variant="cta" />
    </Swap>
    <div class="menu__lang" role="group" aria-label="Language">
      <button type="button" class="menu__lang-btn" data-lang-option="pl" role="option" aria-selected="false">
        Polski
      </button>
      <button type="button" class="menu__lang-btn" data-lang-option="en" role="option" aria-selected="true">
        English
      </button>
    </div>
  </div>
</div>