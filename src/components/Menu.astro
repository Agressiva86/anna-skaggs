---
import { navLinks } from "../data/site";
---

<div class="menu">
  {
    navLinks.map((link) => (
      <>
        <a href={link.href} data-en={link.label} data-pl={link.pl}>{link.label}</a>
        {link.children?.map((child) => (
          <a class="menu__sub" href={child.href} data-en={child.label} data-pl={child.pl}>{child.label}</a>
        ))}
      </>
    ))
  }
</div>
