---
import CfsLogo from "./CfsLogo.astro";

const cols = 12;
---

<div class="stairs-preloader" data-stairs-preloader aria-hidden="true">
  <div class="stairs-preloader__cols">
    {
      Array.from({ length: cols }, (_, i) => (
        <div class="stairs-preloader__col" style={`--i:${i};--n:${cols}`}>
          <div class="stairs-preloader__panel" />
        </div>
      ))
    }
  </div>
  <div class="stairs-preloader__logo" data-preloader-logo>
    <CfsLogo />
  </div>
</div>