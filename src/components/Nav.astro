---
import Arrow from "./Arrow.astro";
import Swap from "./Swap.astro";
import { navLinks, type PageId } from "../data/site";
import { withBase } from "../lib/url";

interface Props {
  variant?: "hero" | "solid";
  current?: PageId | "";
  ctaCurrent?: boolean;
}

const { variant = "solid", current = "", ctaCurrent = false } = Astro.props;
---

<div class:list={["nav", variant === "solid" && "nav--solid"]}>
  <a class="logo" href={withBase("/")} aria-label="Creative Future Studio">
    <span>creative</span>
    <span>future</span>
    <span>studio</span>
  </a>
  <nav class="nav-links" aria-label="Primary">
    {
      navLinks.map((link) => (
        <Swap
          href="#"
          class="nav-link"
          label={link.label}
          current={current === link.id}
        />
      ))
    }
  </nav>
  <Swap
    href={withBase("/contact")}
    class:list={["btn", "nav-cta", variant === "hero" ? "btn--ghost" : "btn--line"]}
    label="Get in touch"
    current={ctaCurrent}
  >
    <Arrow slot="after" variant="cta" />
  </Swap>
  <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span>
  </button>
</div>
