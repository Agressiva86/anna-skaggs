---
import Arrow from "./Arrow.astro";
import Swap from "./Swap.astro";
import { pages, type PageId } from "../data/site";

interface Props {
  variant?: "hero" | "solid";
  current?: PageId | "";
  ctaCurrent?: boolean;
}

const { variant = "solid", current = "", ctaCurrent = false } = Astro.props;
const primary = pages.filter((page) => page.id !== "contact");
---

<div class:list={["nav", variant === "solid" && "nav--solid"]}>
  <a class="logo" href="/">Anna<sup>®</sup></a>
  <nav class="nav-links" aria-label="Primary">
    {
      primary.map((page) => (
        <Swap
          href={page.href}
          class="nav-link"
          label={`<i>${page.index}</i> ${page.name}`}
          current={current === page.id}
        />
      ))
    }
  </nav>
  <Swap
    href="/contact"
    class:list={["btn", "nav-cta", variant === "hero" ? "btn--ghost" : "btn--line"]}
    label="Get in touch"
    current={ctaCurrent}
  >
    <Arrow slot="before" />
  </Swap>
  <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span>
  </button>
</div>
