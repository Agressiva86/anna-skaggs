---
interface Props {
  href: string;
  label: string;
  class?: string;
  current?: boolean;
  animate?: string;
  target?: string;
  rel?: string;
  pl?: string;
}

const { href, label, class: className, current = false, animate, target, rel, pl } = Astro.props;
---

<a
  href={href}
  class:list={[className, "swap-link"]}
  aria-current={current ? "page" : undefined}
  data-animate={animate}
  data-en={pl ? label : undefined}
  data-pl={pl}
  target={target}
  rel={rel}
>
  <slot name="before" />
  <span class="swap">
    <span set:html={label} />
    <span aria-hidden="true" set:html={label} />
  </span>
  <slot name="after" />
</a>
