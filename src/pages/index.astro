---
import Layout from "../layouts/Layout.astro";
import StairsPreloader from "../components/StairsPreloader.astro";
import Nav from "../components/Nav.astro";
import Arrow from "../components/Arrow.astro";
import Swap from "../components/Swap.astro";
import Publications from "../components/Publications.astro";
import { clients, featuredWork } from "../data/site";
import { withBase } from "../lib/url";
const steps = [
  {
    n: "1",
    title: "Strategic Conversation",
    text: "We begin with a focused conversation to understand the business context, ambition and current friction points.",
  },
  {
    n: "2",
    title: "Audit or Workshop",
    text: "Depending on your stage, we start with a diagnostic audit or a strategic workshop to uncover patterns, gaps and opportunities.",
  },
  {
    n: "3",
    title: "Direction & Priorities",
    text: "You receive a clearer point of view, sharper priorities and a practical path forward.",
  },
  {
    n: "4",
    title: "Further Collaboration",
    text: "From there, collaboration may continue through a sprint, advisory support or a staged strategic process.",
  },
];
const testimonials = [
  {
    quote: "While working with Ania, I had the opportunity to work with a very valuable person. Ania is a person focused on development, both her own and that of her employees. She builds relationships with others very well. Everything she does, she does with great attention to the world and others.",
    name: "Grażyna Krzysztofowicz",
    role: "HR Manager/Learning&Development/Talent acquisition",
    image: withBase("/images/about-studies.webp"),
    focus: "0.5 0.46",
  },
  {
    quote: "Empathic meets Interior Design acumen. In my role as Art Director at IKEA Marketing & Communication I've had the great pleasure to work with Anna on several global assignments. She expertly filled the role of Interior Designer, always customer focused, solution driven and open minded, sharing to-the-point Home furnishing insights. Anna's creative skills impress and I have left any discussion we've had feeling more inspired and optimistic. Anna would be a fantastic asset to any team!",
    name: "Jaan Vooremaa",
    role: "Senior Art director at IPEX",
    image: withBase("/images/about-portrait.webp"),
    focus: "0.5 0.18",
  },
  {
    quote: "I've had the pleasure of collaborating with Anna Julia on several new IKEA store projects in Southeast Asia and Mexico, and I've consistently been impressed by her dynamic approach and creativity. Anna Julia excels at generating flamboyant ideas and translating them into beautiful home furnishing solutions. What sets Anna Julia apart is not only her creative vision and ability to think outside the box but also her flexibility and openness to feedback. She adjusts her designs based on input, ensuring each space reflects commercial viability without compromising her unique style. I highly recommend Anna Julia to anyone seeking a talented interior designer capable of bringing creative ideas to life. Her skills, creativity, and openness to feedback make her an invaluable asset to any project.",
    name: "Ana Srdelic",
    role: "Interior Design Manager, IKEA Southeast Asia&Mexico",
    image: withBase("/images/about-studio.webp"),
    focus: "0.5 0.28",
  },
];
const statementStats = [
  {
    value: 14,
    labelEn: "countries where I have delivered projects",
    labelPl: "krajów, w których realizowałam projekt",
  },
  {
    value: 57,
    labelEn: "companies I have collaborated with",
    labelPl: "firm, z którymi współpracowałam",
  },
  {
    value: 32,
    labelEn: "years of experience in the furniture industry",
    labelPl: "lata doświadczenia w branży meblowej",
  },
];
const services = [
  {
    title: "Strategic Brand & Business Audit",
    text: "Diagnosing where your brand, offer and communication lose clarity, value and growth potential.",
  },
  {
    title: "Workshops for CEOs and Teams",
    text: "Helping leadership teams align around direction, priorities and better decisions.",
  },
  {
    title: "Creative Direction & Offer Architecture",
    text: "Building stronger collection logic and clearer presentation of value.",
  },
  {
    title: "Foresight for Furniture & Home",
    text: "Turning signals of change into strategic direction for today.",
  },
  {
    title: "Advisory for Growth and Transformation",
    text: "Providing ongoing support for brands navigating change, repositioning and growth.",
  },
];
---

<Layout
  title="Anna — Studio"
  bodyClass="page-home"
  description="Strategic Brand Direction & Foresight for Premium Furniture Brands"
  image="/images/og.png"
>
  <StairsPreloader />
  <section class="hero hero-skaggs" aria-label="Introduction">
    <div class="hero-bar">
      <Nav variant="hero" current="home" />
    </div>

    <div class="skaggs__pin" data-skaggs-pin>
      <div class="skaggs__view">
        <div class="skaggs__stage">
          <h1 class="skaggs__title">
            <span class="skaggs__line skaggs__line--top">Furniture</span>
            <span class="skaggs__line skaggs__line--bottom">Strategy</span>
          </h1>
          <div class="skaggs__slot" data-skaggs-slot>
            <div class="skaggs__frame" data-skaggs-video>
              <img alt="" data-skaggs-poster />
              <video
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                data-skaggs-player
              >
                <source src={withBase("/video/hero.mp4")} type="video/mp4" />
              </video>
            </div>
          </div>
          <div class="skaggs__captions">
            <div class="skaggs__aside">
              <div class="skaggs__cap-wrap">
                <p class="skaggs__cap">Growth Strategy for Furniture Manufacturers and Interior Design Brands</p>
              </div>
              <Swap href="#services" class="btn btn--accent skaggs__help" label="How Can I help?">
                <Arrow slot="after" variant="cta" />
              </Swap>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main id="content">
    <section class="section">
      <div class="wrap">
        <div class="grid statement-grid">
          <p class="eyebrow statement-eyebrow small-heading" data-animate="rise">Welcome</p>
          <div class="statement-lead">
            <h2 class="statement-heading" data-animate="rise">
              Strategic Brand Direction&nbsp;&amp;<br />
              Foresight for Premium Furniture Brands
            </h2>
            <p class="lead" data-animate="rise">Strong furniture brands turn product strength into customer decisions. I am <span class="mark" data-mark>Anna Skaggs<span class="mark__ink" aria-hidden="true">Anna Skaggs</span></span>, a Creative Director helping interior and furniture manufacturers align their assortment, positioning, and customer experience for sustainable growth.</p>
          </div>
          <div class="about">
            <h2 data-animate="rise">About <span class="mark" data-mark>Anna Skaggs<span class="mark__ink" aria-hidden="true">Anna Skaggs</span></span> – Furniture Brand Strategist</h2>
            <p data-animate="rise">With over two decades of international experience in interior design, retail concepts, and assortment presentation, I help brands move from product-led thinking to strong market value. My expertise bridges the gap between creative design and commercial strategy for the furniture industry.</p>
            <div class="about__actions">
              <Swap href={withBase("/contact")} class="btn btn--accent" label="Book a Strategic Call" animate="rise">
                <Arrow slot="after" variant="cta" />
              </Swap>
              <Swap href={withBase("/studio")} class="btn btn--light" label="more about me" pl="więcej o mnie" animate="rise">
                <Arrow slot="after" variant="cta" />
              </Swap>
            </div>
          </div>
          <div class="frames" data-stagger>
            <div class="frame" data-animate="fade">
              <img src={withBase("/images/about-studies.webp")} alt="Anna Skaggs standing before a wall of brand studies" />
            </div>
            <div class="frame" data-animate="fade">
              <img src={withBase("/images/about-portrait.webp")} alt="Anna Skaggs in the studio" />
            </div>
            <div class="frame" data-animate="fade">
              <img src={withBase("/images/about-studio.webp")} alt="Anna Skaggs beside a canvas" />
            </div>
          </div>
          <div class="statement-stats" data-statement-stats>
            <div class="statement-stats__pin">
              <div class="statement-stats__track">
                {
                  statementStats.map((stat) => (
                    <div class="stat-slide">
                      <article class="stat-tile">
                        <p class="stat-tile__value" data-stat-count={stat.value}>
                          0
                        </p>
                      </article>
                      <div class="statement-stats__rule" aria-hidden="true" />
                      <p class="stat-tile__label" data-en={stat.labelEn} data-pl={stat.labelPl}>
                        {stat.labelPl}
                      </p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="work-pin" aria-labelledby="featured-title">
      <div class="work-pin__sticky">
        <div class="work-pin__track">
          <div class="work-pin__intro">
            <h2 class="work-pin__title" id="featured-title">Featured<br />Work</h2>
            <Swap href={withBase("/work")} class="text-link publications__all" label="See all work" animate="rise">
              <Arrow slot="after" variant="cta" />
            </Swap>
          </div>
          {
            featuredWork.map((project) => (
              <a class="work-card project" href={withBase("/project")}>
                <span class="work-rule"></span>
                <div class="work-card__body">
                  <div class="work-card__media" data-animate="fade">
                    <img src={project.image} alt={project.imageAlt} />
                    <span class="view-pill">View</span>
                  </div>
                  <div class="work-card__copy">
                    <h3>{project.title}</h3>
                    <p>{project.text}</p>
                  </div>
                </div>
              </a>
            ))
          }
          <div class="work-card work-card--end">
            <span class="work-rule"></span>
            <div class="work-card__body">
              <p class="work-card__lead">The full collection of brand, product, and campaign work.</p>
              <Swap href={withBase("/work")} class="text-link publications__all" label="See all work" animate="rise">
                <Arrow slot="after" variant="cta" />
              </Swap>
            </div>
          </div>
          <section class="work-quote" aria-label="Quote">
            <blockquote>
              <p class="statement-heading">A strategic perspective shaped by design, retail and foresight.</p>
              <footer>Anna Skaggs</footer>
            </blockquote>
          </section>
        </div>
      </div>
    </section>

    <section class="section services" id="services" aria-labelledby="services-label">
      <div class="services__surface" aria-hidden="true"></div>
      <div class="wrap">
        <p class="services__label small-heading" id="services-label">Ways I Can Help</p>
        <ul class="services__list">
          {
            services.map((service) => (
              <li class="services__item" id={service.title.startsWith("Foresight") ? "foresight" : undefined}>
                <h2 class="services__name">{service.title}</h2>
                <p class="services__meta">{service.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section section--flush">
      <div class="wrap">
        <div class="grid clients-head statement-grid">
          <p class="eyebrow clients-eyebrow small-heading" data-animate="rise">Clients</p>
          <h2 class="statement-heading statement-title" data-animate="rise">My professional experience across companies including</h2>
        </div>
        <div class="clients" role="region" aria-label="Client logos">
          <div class="clients__track" data-stagger>
            {
              clients.map((client) => (
                <div class="client" data-animate="rise">
                  <img src={client.src} alt={client.alt} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="steps" aria-labelledby="steps-title">
      <div class="steps__sticky">
        <div class="steps__surface" aria-hidden="true"></div>
        <div class="wrap steps__frame">
          <h2 class="steps__title small-heading" id="steps-title">How we work together</h2>
          <div class="steps__board">
            <span class="steps__rail" aria-hidden="true"><span class="steps__rail-fill"></span></span>
            <ol class="steps__list">
              {
                steps.map((step) => (
                  <li class="steps__item">
                    <span class="steps__num" aria-hidden="true">{step.n}</span>
                    <div class="steps__copy">
                      <h3>{step.title}</h3>
                      <p>{step.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="voices" aria-labelledby="voices-title">
      <div class="voices__layout">
        <div class="voices__stage">
        <h2 class="voices__title" id="voices-title">Testimonials from my working journey</h2>
        <div class="voices__photos">
          {
            testimonials.map((item, index) => (
              <div class:list={["voices__photo", index === 0 && "is-active"]}>
                <div class="voices__photo-media" data-animate="fade">
                  <img src={item.image} alt="" />
                </div>
              </div>
          ))
        }
        </div>
        </div>
        <div class="voices__panel">
          <div class="voices__nav">
            <button class="voices__back" type="button" aria-label="Previous review">
              <Arrow />
              Previous
            </button>
            <button class="voices__next" type="button" aria-label="Next review">
              Next
              <Arrow />
            </button>
          </div>
          <div class="voices__viewport">
            <div class="voices__track">
              {
                testimonials.map((item, index) => (
                  <article class:list={["voices__slide", index === 0 && "is-active"]} aria-hidden={index === 0 ? "false" : "true"}>
                    <blockquote>
                      <p>“{item.quote}”</p>
                    </blockquote>
                    <footer>
                      <p class="voices__name">{item.name}</p>
                      <p class="voices__role">{item.role}</p>
                    </footer>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section invite" aria-labelledby="invite-title">
      <div class="wrap">
        <div class="invite__row">
          <h2 class="invite__text statement-heading" id="invite-title" data-animate="rise">
            If your brand needs stronger direction, clearer value and a more coherent path to growth, let’s talk.
          </h2>
          <Swap href={withBase("/contact")} class="btn btn--accent" label="Discuss Your Brand Growth" animate="rise">
            <Arrow slot="after" variant="cta" />
          </Swap>
        </div>
      </div>
    </section>

    <Publications />
  </main>
</Layout>
