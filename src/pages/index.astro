---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Arrow from "../components/Arrow.astro";
import Swap from "../components/Swap.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { clients, projects } from "../data/site";

const featured = projects.slice(0, 3);
const services = [
  {
    title: "Strategic Brand & Business Audit",
    text: "Diagnosing where your brand, offer and communication lose clarity, value and growth potential.",
  },
  {
    title: "Workshops for CEOs and Teams",
    text: "Helping leadership teams align around direction, priorities and better decisions.",
  },
  {
    title: "Creative Direction & Offer Architecture",
    text: "Building stronger collection logic and clearer presentation of value.",
  },
  {
    title: "Foresight for Furniture & Home",
    text: "Turning signals of change into strategic direction for today.",
  },
  {
    title: "Advisory for Growth and Transformation",
    text: "Providing ongoing support for brands navigating change, repositioning and growth.",
  },
];
const shots = [
  { start: 7, cols: 5, top: 0, ratio: 1.15, mStart: 3, mCols: 5, mTop: 0, mRatio: 1.1 },
  { start: 12, cols: 4, top: 19, ratio: 1.25, mStart: 1, mCols: 4, mTop: 29, mRatio: 1.3 },
  { start: 1, cols: 4, top: 38, ratio: 1.45, mStart: 4, mCols: 4, mTop: 64, mRatio: 1.35 },
  { start: 5, cols: 5, top: 75, ratio: 1.15, mStart: 1, mCols: 5, mTop: 104, mRatio: 1.15 },
  { start: 12, cols: 4, top: 102, ratio: 1.4, mStart: 4, mCols: 4, mTop: 149, mRatio: 1.25 },
  { start: 1, cols: 5, top: 139, ratio: 0.85, mStart: 1, mCols: 5, mTop: 192, mRatio: 0.8 },
  { start: 7, cols: 6, top: 177, ratio: 0.72, mStart: 2, mCols: 6, mTop: 240, mRatio: 0.75 },
  { start: 2, cols: 5, top: 222, ratio: 1.3, mStart: 1, mCols: 4, mTop: 296, mRatio: 1.3 },
];
---

<Layout title="Anna — Studio" bodyClass="page-home" newsletter>
  <section class="hero hero-mosaic" aria-label="Selected work">
    <div class="mosaic-nav">
      <Nav variant="hero" current="home" />
    </div>
    <h1 class="visually-hidden">Anna</h1>
    <div class="mosaic-field">
      {
        shots.map((shot) => (
          <a
            class="mosaic-shot hover-shot"
            href="/work"
            style={`--start:${shot.start};--cols:${shot.cols};--top:${shot.top};--ratio:${shot.ratio};--m-start:${shot.mStart};--m-cols:${shot.mCols};--m-top:${shot.mTop};--m-ratio:${shot.mRatio}`}
          >
            <img class="mosaic-shot__fill" src="/images/gallery-placeholder.png" alt="" />
            <img class="mosaic-shot__hover" src="/images/hero-hover.png" alt="" />
            <span class="shot-title">Lorem ipsum</span>
          </a>
        ))
      }
    </div>
    <a class="hero-more" href="#content">
      Learn more about us
      <Arrow />
    </a>
  </section>

  <main id="content">
    <section class="section">
      <div class="wrap">
        <div class="divider" data-animate="line"></div>
        <div class="grid statement-grid">
          <p class="eyebrow statement-eyebrow" data-animate="rise">Welcome</p>
          <h2 class="display-4 statement-title" data-animate="rise">Where craft and clear thinking meet to shape digital work that lasts. We design experiences with enough restraint to feel effortless, and enough precision to move a brand forward.</h2>
          <div class="values" data-stagger>
            <article class="value" data-animate="rise">
              <h3>Innovation</h3>
              <div>
                <h4>Ideas with a point of view</h4>
                <p class="muted">Strategy and making stay in the same room. The work should be sharp enough to notice, and calm enough to live with for a long time.</p>
              </div>
            </article>
            <article class="value" data-animate="rise">
              <h3>Impact</h3>
              <div>
                <h4>Built for the years after launch</h4>
                <p class="muted">A site, a system, or a campaign only counts if it still earns its place later. We design for that longer life, not for a single reveal.</p>
              </div>
            </article>
          </div>
          <div class="frames" data-stagger>
            {
              Array.from({ length: 3 }).map(() => (
                <div class="frame hover-shot" data-animate="reveal">
                  <img class="mosaic-shot__fill" src="/images/gallery-placeholder.png" alt="" />
                  <img class="mosaic-shot__hover" src="/images/hero-hover.png" alt="" />
                  <span class="shot-title">Lorem ipsum</span>
                  <div class="revealer" />
                </div>
              ))
            }
          </div>
          <p class="curious" data-animate="rise">Still curious?</p>
          <Swap href="/studio" class="text-link curious-link" label="Read more about us" animate="rise">
            <Arrow slot="after" />
          </Swap>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="featured-title clip" data-animate="clip"><h2 class="mega">Featured Work</h2></div>
        <div class="divider" data-animate="line"></div>
        <div class="grid featured-head">
          <h3 class="display-3 featured-lead" data-animate="rise">Each project is a chance to turn a clear idea into something people can use.</h3>
          <p class="eyebrow featured-eyebrow" data-animate="rise">Projects</p>
        </div>
        <div class="featured-layout">
          <aside class="featured-aside">
            <div class="featured-aside-inner">
              <p data-animate="rise">Selected work is the clearest record of how we think, design, and build.</p>
              <Swap href="/work" class="text-link" label="See all work" animate="rise">
                <Arrow slot="after" />
              </Swap>
            </div>
          </aside>
          <div class="featured-list">
            {featured.map((project) => <ProjectCard {...project} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="section services" id="services" aria-labelledby="services-label">
      <div class="wrap">
        <p class="services__label" id="services-label">Ways I Can Help</p>
        <ul class="services__list">
          {
            services.map((service) => (
              <li class="services__item">
                <h2 class="services__name">{service.title}</h2>
                <p class="services__meta">{service.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section section--flush">
      <div class="wrap">
        <div class="divider" data-animate="line"></div>
        <div class="grid clients-head statement-grid">
          <p class="eyebrow clients-eyebrow" data-animate="rise">Clients</p>
          <h2 class="display-4 statement-title" data-animate="rise">Teams we have partnered with, from early companies to established brands. The marks themselves arrive with the content.</h2>
        </div>
        <div class="clients" data-stagger>
          {
            clients.map((index) => (
              <div class="client" data-animate="rise">
                <i>{index}</i><span>Logo</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
