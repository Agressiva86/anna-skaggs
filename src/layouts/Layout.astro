---
import "../styles/global.css";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  bodyClass?: string;
  newsletter?: boolean;
  emailHref?: string;
}

const { title, bodyClass, newsletter = false, emailHref = "/contact" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-ext.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#content">Skip to content</a>
    <Menu />
    <slot />
    <Footer newsletter={newsletter} emailHref={emailHref} />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
