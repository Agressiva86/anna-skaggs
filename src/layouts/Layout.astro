---
import "../styles/global.css";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  bodyClass?: string;
  newsletter?: boolean;
  emailHref?: string;
}

const { title, bodyClass, newsletter = false, emailHref = "/contact" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=aspekta@400,500,600,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#content">Skip to content</a>
    <Menu />
    <slot />
    <Footer newsletter={newsletter} emailHref={emailHref} />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
