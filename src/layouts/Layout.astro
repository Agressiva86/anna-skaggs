---
import "../styles/global.css";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  bodyClass?: string;
  description?: string;
  image?: string;
}

const { title, bodyClass, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(withBase(image), Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={imageUrl} />
        </>
      )
    }
    <link rel="preload" href={withBase("/fonts/garvox-regular.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("/fonts/host-grotesk.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("/fonts/host-grotesk-ext.woff2")} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class={bodyClass}>
    <svg class="svg-defs" aria-hidden="true" focusable="false">
      <filter id="client-mono" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0"
          result="gray"
        />
        <feFlood flood-color="#efeeeb" result="paper" />
        <feBlend in="gray" in2="paper" mode="multiply" />
      </filter>
    </svg>
    <a class="skip" href="#content">Skip to content</a>
    <Menu />
    <slot />
    <Footer />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
